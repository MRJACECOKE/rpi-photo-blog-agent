LLAMA_CLI=third_party/llama.cpp/build/bin/llama-completion
LLAMA_MTMD_CLI=third_party/llama.cpp/build/bin/llama-mtmd-cli

VLM_HF_REPO=ggml-org/Qwen2.5-VL-3B-Instruct-GGUF
VLM_QUANT=Q4_K_M
VLM_MODEL_PATH=
VLM_MMPROJ_PATH=

LLM_HF_REPO=unsloth/Qwen3-30B-A3B-Instruct-2507-GGUF
LLM_QUANT_PREFERENCES=IQ2_M,Q2_K_L,Q2_K,IQ2_S
LLM_MODEL_PATH=
MAX_LLM_GGUF_GIB=12.5
ALLOW_OVERSIZED_MODEL=false

MODEL_DIR=models
RUN_DIR=runs
OUTPUT_DIR=outputs

THREADS=4
VLM_CTX_SIZE=2048
LLM_CTX_SIZE=3072
VLM_MAX_TOKENS=640
LLM_MAX_TOKENS=1200

MIN_AVAILABLE_BEFORE_VLM_MB=4096
MIN_AVAILABLE_BEFORE_LLM_MB=12288
MIN_AVAILABLE_DURING_RUN_MB=1536
MEMORY_CHECK_INTERVAL_SEC=1
MEMORY_RECOVERY_TIMEOUT_SEC=120

VLM_TIMEOUT_SEC=1800
LLM_TIMEOUT_SEC=7200
PROCESS_TERMINATE_GRACE_SEC=15

MAX_IMAGE_EDGE=896
JPEG_QUALITY=88

ENABLE_FLASH_ATTN=false
ENABLE_SWAP_WARNING=true
ALLOW_CACHE_DROP=false
BLOG_LANGUAGE=ko
